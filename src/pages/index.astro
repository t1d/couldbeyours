---
import Layout from "@/layouts/main.astro"

// DELIBERATE TYPE ERROR for the Phase 0 CI test. This PR must fail and must never be merged.
const year: number = "2026"
import { DemoDialog } from "@/components/DemoDialog"
import {
  Card,
  CardContent,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from "@/components/ui/card"
---

<Layout title="Atelier – Phase 0" description="Platzhalter-Seite zum Testen der Deploy-Pipeline.">
  <main class="grid min-h-screen place-items-center p-4">
    <!-- No client:* directive: rendered to static HTML at build time, ships no JS. -->
    <Card className="w-full max-w-md">
      <CardHeader>
        <CardTitle>Atelier – Phase 0 ({year})</CardTitle>
        <CardDescription>
          Platzhalter. Diese Seite prüft nur, dass Build, CI und Deployment funktionieren.
        </CardDescription>
      </CardHeader>
      <CardContent className="text-sm text-muted-foreground">
        Die Karte ist statisches HTML. Der Button unten ist eine interaktive React-Insel.
      </CardContent>
      <CardFooter>
        <DemoDialog client:load />
      </CardFooter>
    </Card>
  </main>
</Layout>
