---
import "@/styles/global.css"
import SiteFooter from "@/components/SiteFooter.astro"
import SiteHeader from "@/components/SiteHeader.astro"
import { buildInfo } from "@/lib/build-info"
import { site } from "@/lib/content"
// Preload the Latin subsets of both fonts so text renders in the final font right away.
import headingFont from "@fontsource-variable/cormorant-garamond/files/cormorant-garamond-latin-wght-normal.woff2?url"
import bodyFont from "@fontsource-variable/jost/files/jost-latin-wght-normal.woff2?url"

interface Props {
  /** Page title; the site name is appended. Omit on the home page. */
  title?: string
  description?: string
}

const { title, description = site.description } = Astro.props
const fullTitle = title ? `${title} – ${site.name}` : site.title
const ogImage = new URL(site.ogImage, Astro.site).href
---

<html lang="de-CH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f4ee" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={headingFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_CH" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="build" content={`${buildInfo.branch}@${buildInfo.commit}`} />
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <a
      href="#inhalt"
      class="sr-only z-50 bg-primary px-4 py-2 text-primary-foreground focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Zum Inhalt springen
    </a>
    <SiteHeader />
    <main id="inhalt">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
