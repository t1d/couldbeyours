---
import { ArrowRight } from "lucide-react"
import { Instagram } from "@/components/icons/instagram"
import Seam from "@/components/Seam.astro"
import Wordmark from "@/components/Wordmark.astro"
import { contact, cta, footer, instagram, site } from "@/lib/content"

const year = new Date().getFullYear()
const linkClass = "draw tap inline-flex items-center gap-1.5 hover:text-paper"
const channels = [contact.channels.whatsapp, contact.channels.email, contact.channels.instagram]
---

<!-- The close: on a desktop one dark screen. The seam from the flyer along its top, the wordmark as
     wide as the page, the main action and the ways to reach the atelier, then the links. -->
<footer class="on-ink bg-footer text-paper/80">
  <div class="wrap flex flex-col justify-between gap-16 pt-8 pb-10 lg:min-h-svh lg:pb-[4.5rem]">
    <div>
      <Seam class="text-paper/40" />
      <div class="name mt-16 md:mt-24 lg:mt-28">
        <Wordmark class="text-paper" />
      </div>

      <div class="mt-14 grid gap-12 lg:mt-20 lg:grid-cols-12 lg:gap-x-6">
        <div class="lg:col-span-6">
          <p class="label normal-case">{footer.tagline}</p>
          <a href={cta.href} class="btn mt-6 max-sm:w-full">
            {cta.label}
            <ArrowRight strokeWidth={1.5} aria-hidden="true" />
          </a>
        </div>
        <ul class="space-y-4 lg:col-span-6 lg:col-start-7">
          {channels.map((channel) => (
            <li>
              <span class="label block normal-case">{channel.label}</span>
              <a
                href={channel.href}
                class="draw tap mt-1 inline-block font-heading text-2xl text-paper lining-nums"
              >
                {channel.display}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="flex flex-col gap-4 border-t border-paper/20 pt-5 text-sm md:flex-row md:items-center md:justify-between">
      <ul class="flex flex-wrap gap-x-7 gap-y-4 py-2">
        {footer.links.map((link) => (
          <li>
            <a href={link.href} class={linkClass}>
              {link.label}
            </a>
          </li>
        ))}
        <li>
          <a href={instagram.url} class={linkClass}>
            <Instagram className="size-4" strokeWidth={1.5} aria-hidden="true" />
            Instagram
          </a>
        </li>
      </ul>
      <p>
        © {year} {site.name}
      </p>
    </div>
  </div>
</footer>

<style>
  /* The heart and 14 letters come to about 9.5em: 10cqi fills the width on one line. */
  .name {
    container-type: inline-size;
  }

  .name :global(.wordmark) {
    font-size: clamp(1.75rem, 10cqi, 7.5rem);
  }
</style>
