---
// The hand-drawn heart from the could be yours logo, traced from the original artwork. It is
// filled with the current text colour, so it takes on the colour of the text around it.
import type { HTMLAttributes } from "astro/types"

type Props = HTMLAttributes<"svg">

// Spreading the props also passes on the caller's scoped-style attribute, so a class set by the
// caller (e.g. in Intro.astro) can be styled in the caller's own <style> block.
const props = Astro.props
---

<!-- The outline adds the same 0.6 screen pixels at every size (non-scaling stroke): it keeps the
     thin brush lines visible at header size and is barely noticeable when the heart is large. -->
<svg
  viewBox="0 0 138 143"
  fill="currentColor"
  stroke="currentColor"
  stroke-width="0.6"
  stroke-linejoin="round"
  overflow="visible"
  aria-hidden="true"
  {...props}
