---
import { ArrowRight, Menu, X } from "lucide-react"
import Wordmark from "@/components/Wordmark.astro"
import { appointments, cta, nav } from "@/lib/content"
---

<header class="sticky top-0 z-40 border-b border-border/70 bg-background/90 backdrop-blur-sm">
  <div class="wrap flex h-16 items-center justify-between gap-6 lg:gap-8">
    <a href="/" class="py-2" aria-label="could be yours, zur Startseite">
      <Wordmark class="text-xl" />
    </a>

    <nav aria-label="Hauptnavigation" class="hidden md:ml-auto md:block">
      <ul class="flex gap-6 text-sm tracking-wide lg:gap-8">
        {nav.map((item) => (
          <li>
            <a href={item.href} class="draw whitespace-nowrap hover:text-sage-deep">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a href={cta.href} class="btn btn-sm hidden lg:inline-flex">
      {cta.label}
    </a>

    <!-- Mobile menu: the native popover API handles open/close, Esc and focus order without a
         framework. The script below only closes it after a link is chosen. -->
    <button
      type="button"
      popovertarget="mobile-menu"
      class="-mr-2 inline-flex size-11 items-center justify-center md:hidden"
    >
      <Menu className="size-6" strokeWidth={1.5} aria-hidden="true" />
      <span class="sr-only">Menü öffnen</span>
    </button>
  </div>

  <div
    id="mobile-menu"
    popover
    class="m-0 h-dvh max-h-none w-full max-w-none border-0 bg-background p-0 text-foreground md:hidden"
  >
    <div class="flex h-full flex-col">
      <div class="border-b border-border/70">
        <div class="wrap flex h-16 items-center justify-between">
          <Wordmark class="text-xl" aria-hidden="true" />
          <button
            type="button"
            popovertarget="mobile-menu"
            popovertargetaction="hide"
            class="-mr-2 inline-flex size-11 items-center justify-center"
          >
            <X className="size-6" strokeWidth={1.5} aria-hidden="true" />
            <span class="sr-only">Menü schliessen</span>
          </button>
        </div>
      </div>

      <nav aria-label="Hauptnavigation" class="wrap w-full flex-1 overflow-y-auto pt-10">
        <ul class="space-y-6">
          {nav.map((item) => (
            <li>
              <a href={item.href} class="draw font-heading text-4xl">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="wrap w-full shrink-0 pb-8">
        <p class="text-xs tracking-[0.25em] text-ink-muted uppercase">{appointments}</p>
        <a href={cta.href} class="btn mt-4 w-full">
          {cta.label}
          <ArrowRight strokeWidth={1.5} aria-hidden="true" />
        </a>
      </div>
    </div>
  </div>
</header>

<style is:global>
  /* Keep the page behind the open mobile menu from scrolling. */
  html:has(#mobile-menu:popover-open) {
    overflow: hidden;
  }
</style>

<script>
  const menu = document.getElementById("mobile-menu")
  menu?.addEventListener("click", (event) => {
    if (event.target instanceof Element && event.target.closest("a")) menu.hidePopover()
  })
</script>
