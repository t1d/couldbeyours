---
import { Menu, X } from "lucide-react"
import LogoHeart from "@/components/LogoHeart.astro"
import { nav, site } from "@/lib/content"

const linkClass =
  "underline-offset-8 decoration-sage decoration-1 transition-colors hover:text-sage-deep hover:underline"
---

<header class="sticky top-0 z-40 border-b border-border/70 bg-background/90 backdrop-blur-sm">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 sm:px-8">
    <a href="/" class="inline-flex items-center gap-[0.3em] font-logo text-xl font-bold">
      {site.name}
      <LogoHeart class="h-[0.8em] w-auto" />
    </a>

    <nav aria-label="Hauptnavigation" class="hidden md:block">
      <ul class="flex gap-8 text-sm tracking-wide">
        {nav.map((item) => (
          <li>
            <a href={item.href} class={linkClass}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Mobile menu: the native popover API handles open/close, Esc and focus order without a
         framework. The script below only closes it after a link is chosen. -->
    <button
      type="button"
      popovertarget="mobile-menu"
      class="-mr-2 inline-flex size-11 items-center justify-center md:hidden"
    >
      <Menu className="size-6" strokeWidth={1.5} aria-hidden="true" />
      <span class="sr-only">Menü öffnen</span>
    </button>
  </div>

  <div
    id="mobile-menu"
    popover
    class="m-0 h-dvh max-h-none w-full max-w-none border-0 bg-background p-0 text-foreground md:hidden"
  >
    <div class="flex h-16 items-center justify-between border-b border-border/70 px-5 sm:px-8">
      <span
        class="inline-flex items-center gap-[0.3em] font-logo text-xl font-bold"
        aria-hidden="true"
      >
        {site.name}
        <LogoHeart class="h-[0.8em] w-auto" />
      </span>
      <button
        type="button"
        popovertarget="mobile-menu"
        popovertargetaction="hide"
        class="-mr-2 inline-flex size-11 items-center justify-center"
      >
        <X className="size-6" strokeWidth={1.5} aria-hidden="true" />
        <span class="sr-only">Menü schliessen</span>
      </button>
    </div>
    <nav aria-label="Hauptnavigation" class="px-5 pt-10 sm:px-8">
      <ul class="space-y-6">
        {nav.map((item) => (
          <li>
            <a href={item.href} class:list={["font-heading text-4xl", linkClass]}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style is:global>
  /* Keep the page behind the open mobile menu from scrolling. */
  html:has(#mobile-menu:popover-open) {
    overflow: hidden;
  }
</style>

<script>
  const menu = document.getElementById("mobile-menu")
  menu?.addEventListener("click", (event) => {
    if (event.target instanceof Element && event.target.closest("a")) menu.hidePopover()
  })
</script>
