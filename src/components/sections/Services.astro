---
import SectionHeading from "@/components/SectionHeading.astro"
import { anchors, services } from "@/lib/content"

const headingId = `${anchors.services}-titel`
---

<section id={anchors.services} aria-labelledby={headingId}>
  <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 md:py-28 lg:grid lg:grid-cols-12 lg:items-start lg:gap-16">
    <div class="lg:col-span-4">
      <SectionHeading eyebrow={services.eyebrow} title={services.title} id={headingId} />
      <p class="mt-6 max-w-md leading-relaxed text-ink-muted">{services.intro}</p>
    </div>

    <ol class="mt-12 divide-y border-y lg:col-span-8 lg:mt-0">
      {services.items.map((item, index) => (
        <li class="grid grid-cols-[2.5rem_1fr] gap-x-4 py-8 sm:grid-cols-[3rem_1fr_auto] sm:gap-x-6">
          <span class="pt-1 font-heading text-xl text-sage-deep lining-nums" aria-hidden="true">
            {String(index + 1).padStart(2, "0")}
          </span>
          <div>
            <h3 class="text-3xl">{item.title}</h3>
            <p class="mt-3 max-w-prose leading-relaxed text-ink-muted">{item.text}</p>
          </div>
          {item.price && (
            <p class="col-start-2 mt-4 text-sm tracking-wide whitespace-nowrap sm:col-start-3 sm:mt-2 sm:text-right">
              {item.price}
            </p>
          )}
        </li>
      ))}
    </ol>
  </div>
</section>
