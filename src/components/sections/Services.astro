---
import Section from "@/components/Section.astro"
import SectionHeading from "@/components/SectionHeading.astro"
import { anchors, services } from "@/lib/content"

const headingId = `${anchors.services}-titel`
---

<Section id={anchors.services} aria-labelledby={headingId}>
  <div class="md:flex md:items-end md:justify-between md:gap-16">
    <SectionHeading
      eyebrow={services.eyebrow}
      title={services.title}
      emphasis={services.emphasis}
      id={headingId}
    />
    <p class="mt-6 max-w-md leading-relaxed text-ink-muted md:mt-0">{services.intro}</p>
  </div>

  <ol class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:gap-5">
    {services.items.map((item, index) => (
      <li class="flex flex-col bg-paper-deep p-7 transition-colors duration-500 hover:bg-sage-light motion-reduce:transition-none">
        <span class="font-heading text-5xl leading-none text-sage italic" aria-hidden="true">
          {String(index + 1).padStart(2, "0")}
        </span>
        <h3 class="mt-8 text-3xl">{item.title}</h3>
        <p class="mt-3 leading-relaxed text-ink-muted">{item.text}</p>
        {item.price && (
          <p class="mt-auto pt-8">
            <span class="inline-block rounded-full bg-paper px-3.5 py-1.5 text-sm font-medium tracking-wide text-sage-deep">
              {item.price}
            </span>
          </p>
        )}
      </li>
    ))}
  </ol>
</Section>
