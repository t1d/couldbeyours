---
import { Picture } from "astro:assets"
import { ArrowRight } from "lucide-react"
import LogoHeart from "@/components/LogoHeart.astro"
import Wordmark from "@/components/Wordmark.astro"
import { hero } from "@/lib/content"
---

<section
  aria-labelledby="hero-titel"
  class="wrap pt-10 pb-16 md:pt-16 lg:grid lg:grid-cols-12 lg:items-end lg:gap-12 lg:pb-24"
>
  <div class="lg:col-span-6 lg:pb-10">
    <h1 id="hero-titel">
      <!-- The name is as wide as its column allows: the heart and 14 letters come to about 9.5em,
           so 10cqi keeps them on one line at every screen width. -->
      <span class="name block">
        <Wordmark />
      </span>
      <span class="mt-4 block text-3xl font-light tracking-[0.15em] sm:text-4xl">
        {hero.tagline}
      </span>
    </h1>
    <p class="mt-8 max-w-md text-lg leading-relaxed text-ink-muted">{hero.lead}</p>

    <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4">
      <a href={hero.cta.href} class="btn max-sm:w-full">
        {hero.cta.label}
        <ArrowRight strokeWidth={1.5} aria-hidden="true" />
      </a>
      <a href={hero.secondary.href} class="draw tap text-sm tracking-wide hover:text-sage-deep">
        {hero.secondary.label}
      </a>
    </div>

    <ul class="mt-8 flex flex-wrap gap-x-7 gap-y-2 text-sm text-ink-muted">
      {hero.facts.map((fact) => (
        <li class="flex items-center gap-2.5">
          <LogoHeart class="h-3 w-auto text-sage-deep" />
          {fact}
        </li>
      ))}
    </ul>
  </div>

  <div class="-mx-5 mt-12 sm:mx-0 lg:col-span-6 lg:mt-0">
    <!-- Largest image above the fold: load it right away instead of lazily. -->
    <Picture
      src={hero.image.src}
      alt={hero.image.alt}
      formats={["avif", "webp"]}
      widths={[480, 800, 1200, 1600]}
      sizes="(min-width: 1152px) 520px, (min-width: 1024px) 45vw, 100vw"
      loading="eager"
      fetchpriority="high"
      class="aspect-4/5 w-full object-cover lg:aspect-auto lg:h-[min(46rem,calc(100svh-9rem))]"
    />
  </div>
</section>

<style>
  .name {
    container-type: inline-size;
  }

  .name :global(.wordmark) {
    font-size: clamp(1.75rem, 10cqi, 3.5rem);
  }
</style>
