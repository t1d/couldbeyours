---
import { Picture } from "astro:assets"
import { ArrowRight } from "lucide-react"
import { buttonVariants } from "@/components/ui/button"
import { hero, site } from "@/lib/content"
---

<section class="mx-auto max-w-6xl px-5 pt-10 pb-16 sm:px-8 md:pt-16 lg:grid lg:grid-cols-12 lg:items-end lg:gap-12 lg:pb-24">
  <div class="lg:col-span-5 lg:pb-10">
    <p class="text-xs tracking-[0.25em] text-ink-muted uppercase">{hero.eyebrow}</p>
    <h1 class="mt-4 text-6xl leading-none tracking-tight sm:text-7xl">{site.name}</h1>
    <p class="mt-6 max-w-md text-lg leading-relaxed text-ink-muted">{hero.lead}</p>
    <a
      href={hero.cta.href}
      class={buttonVariants({
        size: "lg",
        className: "mt-8 h-12 gap-2 px-6 text-sm tracking-wide hover:bg-ink",
      })}
    >
      {hero.cta.label}
      <ArrowRight data-icon="inline-end" strokeWidth={1.5} aria-hidden="true" />
    </a>
  </div>

  <div class="-mx-5 mt-12 sm:mx-0 lg:col-span-7 lg:mt-0">
    <!-- Largest image above the fold: load it right away instead of lazily. -->
    <Picture
      src={hero.image.src}
      alt={hero.image.alt}
      formats={["avif", "webp"]}
      widths={[480, 800, 1200, 1600]}
      sizes="(min-width: 1152px) 640px, (min-width: 1024px) 56vw, 100vw"
      loading="eager"
      fetchpriority="high"
      class="aspect-4/5 w-full object-cover lg:aspect-auto lg:h-[min(46rem,calc(100svh-9rem))]"
    />
  </div>
</section>
