---
import { Picture } from "astro:assets"
import { ArrowRight } from "lucide-react"
import LogoHeart from "@/components/LogoHeart.astro"
import { buttonVariants } from "@/components/ui/button"
import { hero, site } from "@/lib/content"
import { cn } from "@/lib/utils"

// When the name wraps on narrow screens, the heart stays with the last word instead of ending up
// alone on a line.
const lastSpace = site.name.lastIndexOf(" ")
const nameStart = site.name.slice(0, lastSpace + 1)
const nameEnd = site.name.slice(lastSpace + 1)
---

<section class="mx-auto max-w-6xl px-5 pt-10 pb-16 sm:px-8 md:pt-16 lg:grid lg:grid-cols-12 lg:items-end lg:gap-12 lg:pb-24">
  <div class="lg:col-span-6 lg:pb-10">
    <h1 class="font-logo text-5xl leading-none font-bold sm:text-6xl lg:text-[2.75rem] xl:text-5xl">
      {nameStart}
      <span class="inline-flex items-center gap-[0.3em] whitespace-nowrap">
        {nameEnd}
        <LogoHeart class="h-[0.8em] w-auto" />
      </span>
    </h1>
    <p class="mt-4 text-3xl font-light tracking-[0.15em] sm:text-4xl">{hero.tagline}</p>
    <p class="mt-8 max-w-md text-lg leading-relaxed text-ink-muted">{hero.lead}</p>
    <a
      href={hero.cta.href}
      class={cn(
        buttonVariants({ size: "lg" }),
        // cva only appends className; cn() resolves the conflicts with the base button classes.
        // Full-strength focus ring with a gap, since the default 50 % ring is too faint here.
        "mt-8 h-12 gap-2 px-6 text-sm tracking-wide hover:bg-ink focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background",
      )}
    >
      {hero.cta.label}
      <ArrowRight data-icon="inline-end" strokeWidth={1.5} aria-hidden="true" />
    </a>
  </div>

  <div class="-mx-5 mt-12 sm:mx-0 lg:col-span-6 lg:mt-0">
    <!-- Largest image above the fold: load it right away instead of lazily. -->
    <Picture
      src={hero.image.src}
      alt={hero.image.alt}
      formats={["avif", "webp"]}
      widths={[480, 800, 1200, 1600]}
      sizes="(min-width: 1152px) 520px, (min-width: 1024px) 45vw, 100vw"
      loading="eager"
      fetchpriority="high"
      class="aspect-4/5 w-full object-cover lg:aspect-auto lg:h-[min(46rem,calc(100svh-9rem))]"
    />
  </div>
</section>
