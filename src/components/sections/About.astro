---
import { Picture } from "astro:assets"
import Section from "@/components/Section.astro"
import SectionHeading from "@/components/SectionHeading.astro"
import { about, anchors } from "@/lib/content"

const headingId = `${anchors.about}-titel`
// The first paragraph is set larger, in the serif face, as the way into the text.
const [lead, ...paragraphs] = about.paragraphs
---

<Section
  id={anchors.about}
  aria-labelledby={headingId}
  tone="sage"
  wrapClass="lg:grid lg:grid-cols-12 lg:items-center lg:gap-16"
>
  <div class="lg:col-span-5">
    <Picture
      src={about.image.src}
      alt={about.image.alt}
      formats={["avif", "webp"]}
      widths={[400, 600, 900, 1200]}
      sizes="(min-width: 1152px) 420px, (min-width: 1024px) 36vw, (min-width: 640px) 28rem, 100vw"
      class="aspect-4/5 w-full object-cover sm:max-w-md"
    />
  </div>

  <div class="mt-12 lg:col-span-7 lg:mt-0">
    <SectionHeading
      eyebrow={about.eyebrow}
      title={about.title}
      emphasis={about.emphasis}
      id={headingId}
    />
    <p class="mt-8 max-w-prose font-heading text-2xl leading-[1.35] font-medium text-pretty">
      {lead}
    </p>
    <div class="mt-6 max-w-prose space-y-5 text-lg leading-relaxed">
      {paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
  </div>
</Section>
