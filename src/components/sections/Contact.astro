---
import { ArrowRight, ArrowUpRight, Mail, MessageCircle } from "lucide-react"
import { Instagram } from "@/components/icons/instagram"
import LogoHeart from "@/components/LogoHeart.astro"
import Section from "@/components/Section.astro"
import SectionHeading from "@/components/SectionHeading.astro"
import { anchors, contact } from "@/lib/content"

const headingId = `${anchors.contact}-titel`
const channels = [
  { ...contact.channels.whatsapp, Icon: MessageCircle },
  { ...contact.channels.email, Icon: Mail },
  { ...contact.channels.instagram, Icon: Instagram },
]
---

<Section
  id={anchors.contact}
  aria-labelledby={headingId}
  wrapClass="lg:grid lg:grid-cols-12 lg:gap-16"
>
  <div class="lg:col-span-7">
    <SectionHeading
      eyebrow={contact.eyebrow}
      title={contact.title}
      emphasis={contact.emphasis}
      id={headingId}
    />
    <p class="mt-6 max-w-md leading-relaxed text-ink-muted">{contact.intro}</p>

    <ul class="mt-10 border-t border-ink">
      {channels.map(({ Icon, ...channel }) => (
        <li class="border-b">
          <a
            href={channel.href}
            class="channel group -mx-4 flex items-center gap-4 px-4 py-6 sm:gap-6"
          >
            <Icon className="size-5 shrink-0 text-sage-deep" strokeWidth={1.5} aria-hidden="true" />
            <span class="min-w-0 flex-1">
              <span class="label block text-ink-muted">{channel.label}</span>
              <span class="mt-1.5 block font-heading text-2xl font-medium lining-nums [overflow-wrap:anywhere] sm:text-4xl">
                {channel.display}
              </span>
            </span>
            <ArrowUpRight
              className="size-6 shrink-0 text-sage-deep transition-transform duration-500 ease-out group-hover:translate-x-1 group-hover:-translate-y-1 motion-reduce:transition-none"
              strokeWidth={1.5}
              aria-hidden="true"
            />
          </a>
        </li>
      ))}
    </ul>
  </div>

  <!-- The card is sewn on like a label: a dashed seam runs just inside its edge. -->
  <div class="mt-16 bg-sage-light p-3 lg:col-span-5 lg:mt-0 lg:self-start">
    <div class="space-y-10 border-[1.5px] border-dashed border-sage-deep/50 p-7 sm:p-9">
      <div>
        <p class="label flex items-center gap-2.5">
          <LogoHeart class="h-3 w-auto text-sage-deep" />
          {contact.appointments.eyebrow}
        </p>
        <h3 class="mt-4 text-[clamp(1.75rem,3vw,2.5rem)] leading-[1.05]">
          {contact.appointments.title}
        </h3>
        <p class="mt-4 leading-relaxed">{contact.appointments.text}</p>
        <a href={contact.appointments.cta.href} class="btn mt-7 max-sm:w-full">
          {contact.appointments.cta.label}
          <ArrowRight strokeWidth={1.5} aria-hidden="true" />
        </a>
      </div>
      <div>
        <p class="label">{contact.address.title}</p>
        <address class="mt-3 leading-relaxed not-italic">
          {contact.address.name}
          <br />
          {contact.address.street}
          <br />
          {contact.address.city}
        </address>
        <a
          href={contact.address.mapUrl}
          class="draw tap mt-3 inline-block text-sm text-sage-deep hover:text-ink"
        >
          {contact.address.mapLabel}
        </a>
      </div>
    </div>
  </div>
</Section>

<style>
  /* A channel is tinted from the left while the pointer is on it. */
  .channel {
    background: linear-gradient(var(--paper-deep), var(--paper-deep)) 0 0 / 0 100% no-repeat;
    transition: background-size 0.6s var(--ease-out);
  }

  .channel:hover,
  .channel:focus-visible {
    background-size: 100% 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .channel {
      transition: none;
    }
  }
</style>
