---
// Svenja's own sentence between hero and about: large, in the serif face, signed with the heart.
import LogoHeart from "@/components/LogoHeart.astro"
import Section from "@/components/Section.astro"
import { statement } from "@/lib/content"
---

<Section aria-label="Haltung" space="tight">
  <figure class="mx-auto max-w-4xl text-center">
    <blockquote>
      <p class="font-heading text-3xl leading-[1.2] font-medium text-balance sm:text-4xl lg:text-5xl">
        {statement.text}
      </p>
    </blockquote>
    <figcaption class="mt-8 inline-flex items-center gap-2.5 text-sm tracking-[0.25em] uppercase">
      <LogoHeart class="h-4 w-auto text-sage-deep" />
      {statement.author}
    </figcaption>
  </figure>
</Section>
