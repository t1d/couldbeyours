---
interface Props {
  /** Small label above the heading, usually the section name. */
  eyebrow: string
  title: string
  /** id of the <h2>, referenced by the section's aria-labelledby. */
  id: string
}

const { eyebrow, title, id } = Astro.props
---

<p class="text-xs tracking-[0.25em] text-ink-muted uppercase">{eyebrow}</p>
<h2 {id} class="mt-4 text-4xl leading-tight sm:text-5xl">
  {title}
</h2>
